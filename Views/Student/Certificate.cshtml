@model SPT.Models.Student
@{
    ViewData["Title"] = "Certificate of Completion";
    bool isEligible = ViewBag.IsEligible;
    int progress = ViewBag.Progress;
    var issuedCert = ViewBag.IssuedCertificate as SPT.Models.Certificate;
}

<div class="container mt-5">
    @if (isEligible && issuedCert != null)
    {
        <div class="text-center mb-4 no-print">
            <h2 class="fw-bold text-success"><i class="fas fa-medal"></i> Congratulations, @Model.FullName!</h2>
            <p class="text-muted">You have successfully completed the <strong>@Model.Track.Name</strong> track.</p>
            <button onclick="window.print()" class="btn btn-primary btn-lg shadow">
                <i class="fas fa-print"></i> Download / Print Certificate
            </button>
        </div>

        <div class="cert-container shadow-lg">
            <div class="frame-outer"></div>
            <div class="frame-inner"></div>

            <div class="cert-id-tag">CERT ID: @issuedCert.CertificateId</div>

            <div class="cert-content">

                <div class="brand-row">
                    <svg width="56" height="56" viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="goldRing" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#e6c65c" />
                                <stop offset="100%" stop-color="#a8801c" />
                            </linearGradient>
                        </defs>
                        <circle cx="45" cy="45" r="42" fill="none" stroke="url(#goldRing)" stroke-width="3" />
                        <circle cx="45" cy="45" r="35" fill="#0a1a3c" />
                        <text x="45" y="59" font-family="Georgia, serif" font-size="42" font-weight="bold"
                              fill="url(#goldRing)" text-anchor="middle">R</text>
                    </svg>
                    <div class="brand-text">
                        <div class="brand-name">RMSys Solutions</div>
                        <div class="brand-sub">SPT ACADEMY</div>
                    </div>
                </div>

                <div class="divider"></div>

                <h1 class="title">Certificate of Completion</h1>

                <div class="presented-to">This certifies that</div>
                <div class="student-name">@Model.FullName</div>

                <div class="body-text">
                    has successfully completed the comprehensive training program in
                    <span class="track-name">@Model.Track.Name</span>,
                    demonstrating proficiency in all required modules, practical
                    assessments, and the final capstone project.
                </div>

                <svg width="110" height="110" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"
                     style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%) rotate(-6deg); opacity:0.92;">
                    <defs>
                        <path id="sealCirclePath" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" />
                    </defs>
                    <circle cx="50" cy="50" r="47" fill="none" stroke="#c9a227" stroke-width="1.5" />
                    <circle cx="50" cy="50" r="37" fill="none" stroke="#0a1a3c" stroke-width="1" />
                    <text font-size="6.3" fill="#0a1a3c" font-family="Georgia, serif" letter-spacing="1.5">
                        <textPath href="#sealCirclePath" startOffset="1%">RMSYS SOLUTIONS • SPT ACADEMY • VERIFIED •</textPath>
                    </text>
                    <text x="50" y="47" text-anchor="middle" font-size="13" font-weight="bold"
                          fill="#0a1a3c" font-family="Georgia, serif">R</text>
                    <text x="50" y="60" text-anchor="middle" font-size="5.5" fill="#c9a227"
                          font-family="Montserrat, sans-serif" letter-spacing="1.5">OFFICIAL</text>
                </svg>

                <div class="bottom-row">
                    <div class="meta-block">
                        <div class="meta-label">Date of Issue</div>
                        <div class="meta-value">@issuedCert.DateIssued.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="meta-block right">
                        <div class="meta-label">Issued By</div>
                        <div class="meta-value" style="font-size:13px;">@issuedCert.IssuedBy</div>
                    </div>
                </div>

            </div>
        </div>
    }
    else if (isEligible && issuedCert == null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="card shadow-sm border-0 py-5">
                    <div class="card-body">
                        <i class="fas fa-hourglass-half fa-3x text-warning opacity-75 mb-3"></i>
                        <h2 class="fw-bold text-success">All Modules Complete! 🎉</h2>
                        <p class="lead text-muted">
                            You've finished everything required for <strong>@Model.Track.Name</strong>.
                            Your certificate is being finalized by an admin and will appear here
                            once it's officially issued.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="card shadow-sm border-0 py-5">
                    <div class="card-body">
                        <div class="mb-4">
                            <span class="fa-stack fa-3x">
                                <i class="fas fa-certificate fa-stack-2x text-muted opacity-25"></i>
                                <i class="fas fa-lock fa-stack-1x text-secondary"></i>
                            </span>
                        </div>
                        <h2 class="fw-bold text-muted">Certificate Locked</h2>
                        <p class="lead text-muted">You're almost there! Complete all modules to unlock your certificate.</p>

                        <div class="my-4 px-5">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold">Progress</span>
                                <span>@ViewBag.CompletedCount / @ViewBag.TotalModules Modules</span>
                            </div>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning"
                                     role="progressbar"
                                     style="width: @progress%">
                                    @progress%
                                </div>
                            </div>
                        </div>

                        <a asp-action="Curriculum" class="btn btn-outline-primary mt-3">
                            <i class="fas fa-book-open"></i> Go to Curriculum
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --navy: #0a1a3c;
        --gold: #c9a227;
        --cream: #fdfbf5;
    }

    .cert-container {
        width: 100%;
        max-width: 1000px;
        aspect-ratio: 10 / 7;
        background: var(--cream);
        position: relative;
        margin: 0 auto;
        box-sizing: border-box;
    }

    .frame-outer {
        position: absolute;
        inset: 18px;
        border: 3px solid var(--navy);
    }

    .frame-inner {
        position: absolute;
        inset: 26px;
        border: 1px solid var(--gold);
    }

    .cert-content {
        position: absolute;
        inset: 55px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: 'Montserrat', sans-serif;
    }

    .brand-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 6px;
    }

    .brand-text {
        text-align: left;
    }

    .brand-name {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 900;
        font-size: 22px;
        color: var(--navy);
        letter-spacing: 0.5px;
        line-height: 1;
    }

    .brand-sub {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 3px;
        color: var(--gold);
        margin-top: 3px;
    }

    .divider {
        width: 90px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        margin: 18px 0;
    }

    h1.title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 900;
        font-size: 34px;
        color: var(--navy);
        text-transform: uppercase;
        letter-spacing: 4px;
        margin: 4px 0 0 0;
    }

    .presented-to {
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7a7a7a;
        margin-top: 22px;
    }

    .student-name {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-weight: 600;
        font-size: 54px;
        color: var(--navy);
        margin: 10px 0 4px 0;
        padding-bottom: 8px;
        border-bottom: 1.5px solid var(--gold);
        display: inline-block;
        min-width: 380px;
    }

    .body-text {
        font-size: 13.5px;
        color: #444;
        max-width: 620px;
        line-height: 1.7;
        margin-top: 18px;
    }

    .track-name {
        color: var(--gold);
        font-weight: 700;
    }

    .bottom-row {
        position: absolute;
        bottom: 40px;
        left: 55px;
        right: 55px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .meta-block {
        text-align: left;
    }

    .meta-label {
        font-size: 9px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 4px;
    }

    .meta-value {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 700;
        font-size: 15px;
        color: var(--navy);
    }

    .meta-block.right {
        text-align: right;
    }

    .cert-id-tag {
        position: absolute;
        top: 34px;
        right: 34px;
        font-size: 9px;
        letter-spacing: 1px;
        color: #b5b5b5;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .cert-container, .cert-container * {
            visibility: visible;
        }

        .cert-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Cormorant+Garamond:ital,wght@0,600;1,600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
