@model List<SPT.Models.SyllabusModule>
@{
    ViewData["Title"] = "Manage Module Progress";
    var student = ViewBag.Student as SPT.Models.Student;
    var completedIds = ViewBag.CompletedIds as HashSet<int> ?? new HashSet<int>();
    int completedCount = completedIds.Count;
    int totalCount = Model.Count;
    int pct = totalCount > 0 ? (int)((double)completedCount / totalCount * 100) : 0;
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="fas fa-tasks me-2 text-primary"></i> Module Progress
        </h4>
        <small class="text-muted">Manually mark completed modules for this student</small>
    </div>
    <a asp-action="Students" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Back to Students
    </a>
</div>

<!-- STUDENT CARD -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <img src="@(student.ProfilePicture ?? "/images/default-avatar.png")"
                 class="rounded-circle border"
                 style="width:55px;height:55px;object-fit:cover;" />
            <div class="flex-grow-1">
                <div class="fw-bold fs-5">@student.FullName</div>
                <div class="text-muted small">@student.Email &nbsp;|&nbsp; Track: <strong>@student.Track?.Name</strong></div>
                <div class="mt-2 d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:8px;max-width:300px;">
                        <div class="progress-bar bg-primary" style="width:@pct%"></div>
                    </div>
                    <small class="fw-bold">@completedCount / @totalCount modules (@pct%)</small>
                </div>
            </div>
            <!-- UNLOCK CAPSTONE BUTTON -->
            <form asp-action="UnlockCapstone" asp-controller="Admin" method="post"
                  onsubmit="return confirm('Unlock capstone for @student.FullName? This lets them submit their project.')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@student.Id" />
                <button type="submit" class="btn btn-warning fw-bold">
                    <i class="fas fa-unlock me-1"></i> Unlock Capstone
                </button>
            </form>
        </div>
    </div>
</div>

<!-- QUICK ACTIONS -->
<div class="d-flex gap-2 mb-3">
    <button type="button" class="btn btn-sm btn-outline-success" onclick="selectAll()">
        <i class="fas fa-check-double me-1"></i> Select All
    </button>
    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deselectAll()">
        <i class="fas fa-times me-1"></i> Deselect All
    </button>
</div>

<!-- MODULES FORM -->
<form asp-action="SaveModuleProgress" asp-controller="Admin" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="studentId" value="@student.Id" />

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            <i class="fas fa-list me-2"></i> @student.Track?.Name — Modules
        </div>
        <div class="list-group list-group-flush" id="moduleList">
            @foreach (var module in Model)
            {
                bool isCompleted = completedIds.Contains(module.Id);
                string rowClass = isCompleted ? "list-group-item-success" : "";
                string badgeColor = module.DifficultyLevel == "Beginner" ? "bg-success"
                    : module.DifficultyLevel == "Intermediate" ? "bg-warning text-dark"
                    : module.DifficultyLevel == "Advanced" ? "bg-danger"
                    : "bg-dark";

                <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 @rowClass module-row"
                       style="cursor:pointer;">
                    <input type="checkbox"
                           name="completedModuleIds"
                           value="@module.Id"
                           class="form-check-input module-checkbox"
                           style="width:20px;height:20px;"
                    @(isCompleted ? "checked" : "") />

                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold">@module.DisplayOrder. @module.ModuleName</span>
                            @if (module.IsMiniProject)
                            {
                                <span class="badge bg-primary">Mini Project</span>
                            }
                            @if (module.HasQuiz)
                            {
                                <span class="badge bg-info text-dark">Quiz</span>
                            }
                        </div>
                        <small class="text-muted">
                            @module.ModuleCode &nbsp;|&nbsp; @module.RequiredHours hrs required
                            &nbsp;|&nbsp;
                            <span class="badge @badgeColor" style="font-size:0.7rem;">@module.DifficultyLevel</span>
                        </small>
                    </div>

                    @if (isCompleted)
                    {
                        <span class="badge bg-success px-2">
                            <i class="fas fa-check me-1"></i> Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border px-2">Not Done</span>
                    }
                </label>
            }
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i> Save Progress
        </button>
        <a asp-action="Students" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Highlight row when checkbox changes
        document.querySelectorAll('.module-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var row = this.closest('.module-row');
                if (this.checked) {
                    row.classList.add('list-group-item-success');
                    row.querySelector('.badge:last-child').outerHTML =
                        '<span class="badge bg-success px-2"><i class="fas fa-check me-1"></i> Completed</span>';
                } else {
                    row.classList.remove('list-group-item-success');
                }
            });
        });

        function selectAll() {
            document.querySelectorAll('.module-checkbox').forEach(function (cb) {
                cb.checked = true;
                cb.closest('.module-row').classList.add('list-group-item-success');
            });
        }

        function deselectAll() {
            document.querySelectorAll('.module-checkbox').forEach(function (cb) {
                cb.checked = false;
                cb.closest('.module-row').classList.remove('list-group-item-success');
            });
        }
    </script>
}
